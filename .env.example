# =======================================================================
# KONEKSI DATABASE (SUPABASE)
# Dapatkan nilai ini dari Pengaturan Database Supabase Anda.
# =======================================================================

# Connect to Supabase via connection pooling (Prisma runtime)
# Biasanya memiliki format: prisma://aws-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="prisma://[POOLER_HOST]:6543/[DB_NAME]?pgbouncer=true&connection_limit=1"

# Direct connection to the database. Used for migrations (Prisma migrate/studio)
# Biasanya memiliki format: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]
DIRECT_URL="postgresql://postgres:[SUPABASE_DB_PASSWORD]@[SUPABASE_DB_HOST]:5432/postgres"

# =======================================================================
# PENGATURAN APLIKASI DAN KEAMANAN
# =======================================================================1

# Secret key untuk mengenkripsi JWT/Session, gunakan nilai acak yang sangat panjang.
# Jalankan perintah: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
SEED_ADMIN_PASSWORD="[ACAK_16_BYTES_BASE64]"

# Secret key untuk refresh token, harus lebih panjang dan kompleks.
# Jalankan perintah: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SEED_REFRESH_TOKEN="[ACAK_48_BYTES_BASE64_SANGAT_PANJANG]"

# Durasi kadaluarsa Access Token (misal: 15m, 1h, 1d)
ACCESS_TOKEN_EXPIRES_IN="15m"

# Durasi kadaluarsa Refresh Token (misal: 7d, 30d)
REFRESH_TOKEN_EXPIRES_IN="7d"

# Port untuk menjalankan server Express (misal: 3000, 5000)
PORT=5000